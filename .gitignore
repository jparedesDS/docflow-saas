# ===========================================
# DocFlow — .gitignore
# ===========================================

# Entorno virtual Python
docflow_env/
venv/
.venv/
env/
.env/

# Bytecode y caché
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
dist/
build/

# Variables de entorno (secretos)
.env
*.env
!.env.example
docflow/frontend/.env

# DocuSign — clave RSA privada (nunca subir)
docusign_private.pem
**/docusign_private.pem

# IDE / Editor
.idea/
.vscode/
*.swp
*.swo

# Claude Code
.claude/

# Logs y datos generados en runtime
*.log
docflow/backend/logs/

# Runtime state JSON (auto-generados por la app)
docflow/backend/notifications_log.json
docflow/backend/processed_emails.json
docflow/backend/agenda_data.json
docflow/backend/claims_log.json
docflow/backend/polling_status.json
docflow/backend/scheduled_reports.json
docflow/backend/folder_sync_state.json
docflow/backend/response_templates.json

# File locks (json_store.py)
*.json.lock

# Auth data (hashes bcrypt)
docflow/backend/users.json

# Datos reales de empresa (PII, nunca subir)
*.xlsx
*.xls
data_tags.xlsx
identificationm.txt

# Emails descargados / archivos temporales
*.msg
*.htm
*_archivos/

# Scripts de utilidad locales
read_tags.py

# package.json duplicados en raíz (el real está en docflow/frontend/)
/package.json
/package-lock.json

# OS
.DS_Store
Thumbs.db
desktop.ini

# Tests / cobertura
.pytest_cache/
.coverage
htmlcov/
.tox/

# Node
node_modules/
npm-debug.log*

# Alembic cache
docflow/backend/alembic/__pycache__/
docflow/backend/alembic/versions/__pycache__/

# Archivo temporal de desarrollo
docflow/backend/services/_temp_monthly.py

# Config local MCP
.mcp.json

# Repos externos clonados en el directorio
taste-skill/
email-best-practices/

# Scripts de diagnóstico/test locales
docflow/backend/diagnose_*.py
docflow/backend/test_*.py
