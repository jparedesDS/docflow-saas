# ── Environment ──────────────────────────────────────
# Values: development | production
ENV=development

# ── Storage Backend ────────────────────────────────
# Values: excel (default) | postgres
STORAGE_BACKEND=excel

# ── PostgreSQL (required when STORAGE_BACKEND=postgres) ──
DATABASE_URL=postgresql://docflow:docflow@localhost:5432/docflow

# ── Security ─────────────────────────────────────────
# REQUIRED in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=docflow-dev-secret-change-me

# ── CORS ─────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000

# ── Email (Resend - legacy) ──────────────────────────
RESEND_API_KEY=re_your_api_key_here
FROM_EMAIL=onboarding@resend.dev

# ── IMAP (email reading) ────────────────────────────
IMAP_HOST=imap.soljem.com
IMAP_PORT=993
IMAP_USER=documentacion@eipsa.es
IMAP_PASS=

# ── SMTP (email sending) ────────────────────────────
SMTP_HOST=smtp.soljem.com
SMTP_PORT=465
SMTP_USER=documentacion@eipsa.es
SMTP_PASS=

# ── Anthropic AI ─────────────────────────────────────
ANTHROPIC_API_KEY=

# ── DocuSign eSignature ──────────────────────────────
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_BASE_URL=https://demo.docusign.net
DOCUSIGN_RSA_PRIVATE_KEY_PATH=docusign_private.pem

# ── Stripe (Billing) ──────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_ENTERPRISE=price_...

# ── Paths ────────────────────────────────────────────
# Backup destination (default: ./backups)
BACKUP_DEST=./backups

# Base path for order folders (network storage)
# PEDIDOS_BASE_PATH=M:\base de datos de pedidos
